# Vobiz calling backend for the Freshdesk panel.
# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
#
# There is no Vobiz account in here, on purpose. The backend serves any Vobiz
# account: each agent signs in to the panel, either with their account's Auth ID
# and Auth Token ("Vobiz account" tab) or with an existing SIP endpoint and a
# caller ID ("SIP direct" tab). Auth Tokens are held in memory only; SIP
# endpoints and the application are created in the agent's own account at
# sign-in. Nothing here names an account, a number or an endpoint.

# ── Where Vobiz reaches this backend ───────────────────────────────────────
# Public https URL, no trailing slash: your tunnel or your domain. Sign-in
# creates (or reuses) an application in the agent's account whose answer URL
# is PUBLIC_BASE + /answer.
PUBLIC_BASE=https://calling.example.com

PORT=8093
# HOST=127.0.0.1

# Signs recording playback links. Set it to a long random value, or links stop
# working whenever the backend restarts:  openssl rand -hex 32
SIGNING_SECRET=

# Where the endpoint map is kept: {authId:agentId -> endpointId, username}.
# Ids only, never a password or a token. Written mode 0600. Default backend/data.
# DATA_DIR=backend/data

# ── Behaviour ──────────────────────────────────────────────────────────────
# conference (default): the agent waits in a room and the customer is dialled
# into it over the REST API. dial: plain <Dial><Number>. SIP-direct agents
# always use dial, because there are no account credentials to place a REST
# leg with. See docs/architecture.md.
# OUTBOUND_MODE=conference

# Record every call (both directions). Tell the people you call.
# RECORD_CALLS=1

# How long an inbound call rings the browser, in seconds.
# INBOUND_RING_SECONDS=30

# off | log | require. "log" checks Vobiz's X-Vobiz-Signature-V3 on every
# webhook — with the Auth Token of the account the call belongs to — and logs a
# mismatch; switch to "require" once the log reads clean. "require" needs at
# least one agent signed in with a Vobiz account, since SIP direct has no token
# to check against.
# VOBIZ_WEBHOOK_SIGNATURE=log

# Name given to the application sign-in creates in each account.
# VOBIZ_APP_NAME=Freshdesk-Calling

# How long a panel sign-in lasts, in hours.
# SESSION_TTL_HOURS=12

# Extra origins allowed to call this backend, comma-separated. *.freshdesk.com,
# *.myfreshworks.com, *.freshworks.com and localhost are already allowed. The
# backend logs any origin it refuses — copy it from there if you need to.
# ALLOWED_ORIGINS=https://*.example.com
