# Vobiz calling backend for the Freshdesk panel.
# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# ── The Vobiz account this backend acts for ────────────────────────────────
# console.vobiz.ai → API credentials. Agents sign in to the panel with these
# same two values, and the backend refuses any other pair.
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=replace-with-your-auth-token

# A number this account owns, in E.164. The default caller ID, and the number
# inbound calls are routed to from the panel's "Enable inbound calls" button.
VOBIZ_FROM_NUMBER=+919876543210

# ── The SIP endpoint the panel registers as ────────────────────────────────
# console.vobiz.ai → Endpoints. Use the username Vobiz STORED, which can differ
# from the one you typed when creating it — read it back from the console.
VOBIZ_SIP_USER=your-endpoint-username
VOBIZ_SIP_PASSWORD=replace-with-the-endpoint-password

# For more than one agent, give each their own endpoint in a JSON file instead
# (see agents.example.json) and point at it. When set, VOBIZ_SIP_USER/PASSWORD
# are ignored and only the identities in the file can sign in.
# AGENTS_FILE=backend/agents.json

# ── Where Vobiz reaches this backend ───────────────────────────────────────
# Public https URL, no trailing slash: your tunnel or your domain. The answer
# URL to configure in Vobiz is PUBLIC_BASE + /answer.
PUBLIC_BASE=https://calling.example.com

PORT=8093
# HOST=127.0.0.1

# ── Behaviour ──────────────────────────────────────────────────────────────
# conference (default): the agent waits in a room and the customer is dialled
# into it over the REST API. dial: plain <Dial><Number>. See docs/architecture.md.
# OUTBOUND_MODE=conference

# Record every call (both directions). Tell the people you call.
# RECORD_CALLS=1

# How long an inbound call rings the browser, in seconds.
# INBOUND_RING_SECONDS=30

# off | log | require. "log" checks Vobiz's X-Vobiz-Signature-V3 on every
# webhook and logs a mismatch; switch to "require" once the log reads clean.
# VOBIZ_WEBHOOK_SIGNATURE=log

# Signs recording playback links. Set it to a long random value, or links stop
# working whenever the backend restarts:  openssl rand -hex 32
SIGNING_SECRET=

# Extra origins allowed to call this backend, comma-separated. *.freshdesk.com,
# *.myfreshworks.com, *.freshworks.com and localhost are already allowed. The
# backend logs any origin it refuses — copy it from there if you need to.
# ALLOWED_ORIGINS=https://*.example.com
